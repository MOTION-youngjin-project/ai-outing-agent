DATABASE_URL="mysql://user:password@localhost:3306/outing_agent"
GEMINI_API_KEY=""
CULTURE_PORTAL_API_KEY=""
DAEGU_PARKING_API_KEY=""
KAKAO_API_KEY=""
# 지도(Dynamic Map)와 경로/요금(Directions 15) — NAVER Cloud Platform Maps 콘솔에서 발급
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=""
NAVER_MAP_CLIENT_SECRET=""
# 공공데이터포털(data.go.kr) 계정 단위로 발급되는 일반 인증키 — 에어코리아(대기질),
# 기상청(날씨), 한국관광공사_국문 관광정보 서비스_GW, 대구광역시_관광지가 전부 이 키 하나를
# 공유해서 쓴다(같은 계정에서 승인받은 API는 키가 동일함). 새 data.go.kr API를 추가로
# 승인받아도 이 키를 그대로 쓰면 된다 — 별도 변수 안 만들어도 됨.
DATA_GO_KR_API_KEY=""
# openssl rand -base64 32 로 생성
AUTH_SECRET=""
# LangSmith 트레이싱(선택) — smith.langchain.com 가입 후 발급(무료 티어 있음).
# 비워두면 트레이싱 없이 그냥 동작한다(langsmith 패키지가 키 없으면 조용히 스킵).
# agent.ts 코드 수정 없이 이 환경변수만으로 langchain/langgraph 호출이 자동 추적됨 —
# recursion limit 등 에이전트 실패 시 실제 도구 호출 순서를 LangSmith 대시보드에서 볼 수 있다.
LANGSMITH_TRACING="true"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="ai-outing-agent"
